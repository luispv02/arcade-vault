# Copia este archivo a .env.local y completa los valores. No subas .env.local al repositorio.

# API key de Resend (https://resend.com/api-keys). Solo se lee en el servidor.
RESEND_API_KEY=

# Destinatario de los mensajes del formulario de contacto.
# Con el remitente onboarding@resend.dev debe ser el correo dueño de la cuenta de Resend.
CONTACT_TO_EMAIL=
